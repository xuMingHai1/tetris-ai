root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.java]
indent_style = space
indent_size = 4
tab_width = 4
max_line_length = 120

# Keep Java formatting aligned with the IntelliJ IDEA style used by the project.
ij_java_continuation_indent_size = 8
ij_java_else_on_new_line = true
ij_java_while_on_new_line = true
ij_java_catch_on_new_line = true
ij_java_finally_on_new_line = true

[*.xml]
indent_style = space
indent_size = 4

[*.{yml,yaml,json}]
indent_style = space
indent_size = 2

[*.{properties,md}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{cmd,bat}]
end_of_line = crlf
